 package="app.manhwa.translator" content-desc="" checkable="true" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[864,430][1001,556]" /><node index="4" text="" resource-id="" class="android.view.View" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,595][494,721]"><node index="0" text="Tester CPU / GPU" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[132,631][441,684]" /></node><node index="5" text="Traduction accélérée (essai)" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,783][648,846]" /><node index="6" text="Gemma garde en mémoire les consignes de traduction au lieu de les relire à chaque page : moins de calcul, donc en théorie plus rapide et moins chaud. Le texte peut changer un peu. Lancez d'abord la comparaison ci-dessous ; si la copie échoue trop souvent, l'application coupe l'essai toute seule." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,846][832,1141]" /><node NAF="true" index="7" text="" resource-id="" class="android.view.View" package="app.manhwa.translator" content-desc="" checkable="true" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[864,899][1001,1025]" /><node index="8" text="Sans décodage spéculatif" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1173][601,1236]" /><node index="9" text="Avec l'essai, coupe le décodage spéculatif (une accélération interne qui ne s'entend pas toujours avec la copie). La copie est plus régulière, mais l'écriture de la traduction est plus lente. À n'activer que si la comparaison le recommande." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1236][832,1447]" /><node index="10" text="" resource-id="" class="android.view.View" package="app.manhwa.translator" content-desc="" checkable="true" checked="false" clickable="true" enabled="false" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[864,1247][1001,1373]" /><node index="11" text="" resource-id="" class="android.view.View" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1475][664,1601]"><node index="0" text="Comparer normal / accéléré" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusa