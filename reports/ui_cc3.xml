focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1167][587,1210]" /><node index="7" text="Une traduction écrite à la main, une traduction supprimée, un texte déplacé, agrandi ou ajouté : chaque correction est rangée sous le chapitre où elle a été faite. « Défaire » la retire et la traduction automatique revient." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1252][1001,1421]" /><node index="8" text="Aucune correction." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1453][388,1506]" /><node index="9" text="Traductions retenues (1)" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1573][495,1626]" /><node index="10" text="Une traduction écrite à la main est reprise chaque fois que le même texte est lu. Celles-ci ne sont plus liées à une correction listée ci-dessus (rétablie depuis l'éditeur, par exemple)." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1658][1001,1827]" /><node index="11" text="TEXTE ORPHELIN  →  Traduction orpheline" resource-id="" class="android.widget.TextView" pack