 content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,358][564,401]" /><node index="2" text="Ces textes restent tels quels sur les pages : ils ne sont pas traduits. Pour en ajouter, appui long sur une traduction puis « Ignorer ce texte… »." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,443][1001,570]" /><node index="3" text="Aucun texte ignoré." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,602][403,655]" /><node index="4" text="Bandeaux de début ou de fin de chapitre : l'image n'est ni lue ni traduite. Pour en ajouter, appui long sur l'image puis « Ne jamais traduire cette image »." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,722][1001,849]" /><node index="5" text="Aucune image ignorée." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,881][457,934]" /><node index="6" text="TERMES DU GLOSSAIRE (0)" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1034][486,1077]" /><node index="7" text="Un terme est remplacé par votre traduction chaque fois qu'il apparaît. Le retirer ne change pas les pages déjà traduites : elles gardent leur traduction jusqu'à ce que la page soit retraduite (réglages rapides › Retraduire)." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1119][1001,1288]" /><node index="8" text="Aucun terme." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1320][301,1373]" /><node index="9" text="" resource-id="" class="android.view.View" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1430][1001,1556]"><node index="0" text="Ajouter ou modifier des termes" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1440][717,1503]" /><node index="1" text="Ouvre le glossaire" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1503][347,1546]" /></node><node index="10" text="CORRECTIONS PAR CHAPITRE (0)" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1646][587,1689]" /><node index="11" text="Une traduction écrite à la main, une traduction supprimée, un texte déplacé, agrandi ou ajouté : chaque correction est rangée sous le chapitre où elle a été faite. « Défaire » la retire et la traduction automatique revient." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1731][1001,1900]" /><node index="12" text="Aucune correction." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,1932][388,1985]" /></node><node index="9" text="" resource-id="" class="android.view.View" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[69,2164][315,2295]"><node index="0" text="" resource-id="" class="android.view.View" package="app.manhwa.translator" content-desc="Lecture" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selecte