" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,443][1001,570]" /><node index="3" text="Aucun texte ignoré." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,602][403,655]" /><node index="4" text="Bandeaux de début ou de fin de chapitre : l'image n'est ni lue ni traduite. Pour en ajouter, appui long sur l'image puis « Ne jamais traduire cette image »." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,722][1001,849]" /><node index="5" text="Aucune image ignorée." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,881][457,934]" /><node index="6" text="TERMES DU GLOSSAIRE (0)" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1034][486,1077]" /><node index="7" text="Un terme est remplacé par votre traduction chaque fois qu'il apparaît. Le retirer ne change pas les pages déjà traduites : elles gardent leur traduction jusqu'à ce que la page soit retraduite (réglages rapides › Retraduire)." resou