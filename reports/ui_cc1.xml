se" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,530][1001,657]" /><node index="3" text="Aucun texte ignoré." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,689][403,742]" /><node index="4" text="Bandeaux de début ou de fin de chapitre : l'image n'est ni lue ni traduite. Pour en ajouter, appui long sur l'image puis « Ne jamais traduire cette image »." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,809][1001,936]" /><node index="5" text="Aucune image ignorée." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[79,968][457,1021]" /><node index="6" text="TERMES DU GLOSSAIRE (1)" resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[53,1121][486,1164]" /><node index="7" text="Un terme est remplacé par votre traduction chaque fois qu'il apparaît. Le retirer ne change pas les pages déjà traduites : elles gardent leur traduction jusqu'à ce que la page soit retraduite (réglages rapides › Retraduire)." resource-id="" class="android.widget.TextView" package="app.manhwa.translator" content-desc="" checkable="false" checke